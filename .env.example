KIS_APP_KEY=
KIS_APP_SECRET=
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_WS_URL=ws://ops.koreainvestment.com:21000
# Optional: use a separate overseas-futures API key pair. Otherwise uses KIS_APP_*.
KIS_FUTURES_APP_KEY=
KIS_FUTURES_APP_SECRET=
# Optional override; blank automatically selects NQ's near month from KIS master.
KIS_NQ_CONTRACT=
# KIS received/chart timestamp interpretation (IANA timezone).
KIS_FUTURES_TIME_ZONE=Asia/Seoul
PORT=8002

# Shared dashboard storage (persist this directory across server updates)
STOCK8_DATA_DIR=./data
STOCK8_PASSWORD=1222
